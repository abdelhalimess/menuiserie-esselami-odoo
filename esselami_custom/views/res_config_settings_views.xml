<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_esselami" model="ir.ui.view">
        <field name="name">res.config.settings.form.esselami</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="esselami_discount_setting"
                         string="Validation des remises"
                         help="Seuil au-delà duquel un devis doit être validé par un responsable.">
                    <field name="esselami_discount_threshold"/>
                </setting>
                <setting id="esselami_capacity_setting"
                         string="Capacité atelier"
                         help="Base de calcul du délai de fabrication affiché sur les devis.">
                    <field name="esselami_daily_capacity"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
